<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="br.com.klabin.zewmpicking2.controller.Details"
>
    <Dialog
        id="AlturaPaleteDialogID"
        contentWidth="20em"
        title="{i18n>titleAlturaPalete}"
        titleAlignment="Center"
    >
        <content>
            <VBox
                width="100%"
                direction="Column"
                id="vbox0AlturaPalete"
            >
                <items>
                    <sap.ui.layout.form:SimpleForm
                        xmlns="sap.m"
                        xmlns:core="sap.ui.core"
                        xmlns:sap.ui.layout.form="sap.ui.layout.form"
                        editable="true"
                        layout="ResponsiveGridLayout"
                        id="form0AlturaPalete"
                    >
                        <sap.ui.layout.form:content>
                            <VBox
                                width="100%"
                                direction="Column"
                                id="vbox0AlturaPaleteInt"
                            >
                                <items>
                                    <Text
                                        xmlns:core="sap.ui.core"
                                        xmlns="sap.m"
                                        text="{i18n>informAlturaPalete}"
                                        id="TextInformAltPalete"
                                    />
                                    <MaskInput
                                        mask="{i18n>maskAltura}"
                                        placeholderSymbol="{i18n>placeholderSymbolAltura}"
                                        placeholder="{i18n>alturaPalete}"
                                        id="InputAlturaPaleteID"
                                    />
                                </items>
                            </VBox>
                        </sap.ui.layout.form:content>
                    </sap.ui.layout.form:SimpleForm>
                </items>
            </VBox>
        </content>

        <endButton>
            <Button
                xmlns="sap.m"
                text="{i18n>btnContinuarAltura}"
                id="BtnContinuarAlturaPaleteID"
                type="Emphasized"
                press="onCheckAlturaPalete"
            />
        </endButton>

        <beginButton>
            <Button
                xmlns="sap.m"
                text="{i18n>btnCancelarAltura}"
                id="BtnCancelarAlturaPaleteID"
                type="Reject"
                press="onCloseAltPalete"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
