<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="br.com.klabin.zewmpicking2.controller.Details"
>
    <Dialog
        id="DialogPopoverID"
        contentWidth="25em"
        title="{i18n>pPLotes}"
        titleAlignment="Center"
    >
        <content>
            <sap.ui.layout.form:SimpleForm
                xmlns:sap.ui.layout.form="sap.ui.layout.form"
                editable="true"
                layout="ResponsiveGridLayout"
                id="form0"
                width="100%"
            >
                <sap.ui.layout.form:content>
                    <VBox
                        width="100%"
                        direction="Column"
                        id="vbox0Popover2"
                    >
                        <items>
                            <sap.ui.layout.form:SimpleForm
                                xmlns="sap.m"
                                xmlns:core="sap.ui.core"
                                xmlns:sap.ui.layout.form="sap.ui.layout.form"
                                editable="true"
                                layout="ResponsiveGridLayout"
                                id="form0_1721318296100"
                            >
                                <sap.ui.layout.form:content>
                                    <VBox
                                        width="100%"
                                        direction="Column"
                                        id="vbox1Popover2"
                                    >
                                        <items>
                                            <FormattedText
                                                id="_IDGenFormattedText7Pp2"
                                                htmlText="{i18n>fornecimentoItem} {MDL_HeaderDetailDetail&gt;/Fornecimento} / {MDL_HeaderDetailDetail>/FornecimentoItem}"
                                            />
                                            <FormattedText
                                                id="_IDGenFormattedText8Pp2"
                                                htmlText="{i18n>pedido} {MDL_HeaderDetailDetail&gt;/Pedido} / {MDL_HeaderDetailDetail>/PedidoItem}"
                                            />
                                            <FormattedText
                                                id="_IDGenFormattedText9Pp2"
                                                htmlText="{i18n>cliente} {MDL_HeaderDetailDetail&gt;/Cliente}"
                                            />
                                            <FormattedText
                                                id="_IDGenFormattedText10Pp2"
                                                htmlText="{i18n>material} {MDL_HeaderDetailDetail&gt;/Material}"
                                            />
                                        </items>
                                    </VBox>
                                </sap.ui.layout.form:content>
                            </sap.ui.layout.form:SimpleForm>
                            <Toolbar
                                width="100%"
                                id="toolbar1"
                            >
                                <content>
                                    <Title
                                        text="{MDL_HeaderDetailDetail>/Qtd} {i18n>lotesLow}{MDL_HeaderDetailDetail>/s}"
                                        id="TitleQtds"
                                    />
                                </content>
                            </Toolbar>
                            <VBox
                                width="100%"
                                direction="Column"
                                id="vbox0_1721318165816pp"
                            >
                                <items>
                                    <Table
                                        xmlns:sap.ui.layout.form="sap.ui.layout.form"
                                        xmlns:core="sap.ui.core"
                                        xmlns="sap.m"
                                        xmlns:cd="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
                                        noDataText="{i18n>NothingLotes}"
                                        id="table1Popoverr"
                                        items="{        path: 'MDL_Lotes>/',        sorter: {         path: 'Lgpla'        }       }"
                                    >
                                        <items>
                                            <ColumnListItem
                                                type="Active"
                                                id="item1_copy_table1Popoverr_0_copy_table1Popoverr_0"
                                            >
                                                <cells>
                                                    <Text
                                                        text="{MDL_Lotes>Charg}"
                                                        id="text4_copy_table1Popoverr_0_copy_table1Popoverr_0"
                                                    />
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                        <columns>
                                            <Column id="column0pp" />
                                        </columns>
                                    </Table>
                                </items>
                            </VBox>
                        </items>
                    </VBox>
                </sap.ui.layout.form:content>
            </sap.ui.layout.form:SimpleForm>
        </content>
        <endButton>
            <Button
                xmlns="sap.m"
                id="BtnSairPopover"
                activeIcon="sap-icon://sys-cancel-2"
                icon="sap-icon://decline"
                press="onClosePopover"
                type="Reject"
                text="Fechar"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
