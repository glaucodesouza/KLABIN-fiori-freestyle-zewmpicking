<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="br.com.klabin.zewmpicking2.controller.Details"
>
    <Dialog
        id="BarCodeDialogID"
        contentWidth="25em"
        title="{i18n>barTitle}"
        titleAlignment="Center"
    >
        <content>
            <VBox
                width="100%"
                direction="Column"
                id="vbox0CodBarras2"
            >
                <items>
                    <sap.ui.layout.form:SimpleForm
                        xmlns:sap.ui.layout.form="sap.ui.layout.form"
                        editable="true"
                        layout="ResponsiveGridLayout"
                        id="form1CodBarras2"
                    >
                        <sap.ui.layout.form:content>
                            <VBox
                                width="100%"
                                direction="Column"
                                id="vbox0"
                            >
                                <items>
                                    <Text
                                        xmlns:core="sap.ui.core"
                                        xmlns:sap.ui.layout.form="sap.ui.layout.form"
                                        xmlns="sap.m"
                                        text="{i18n>barText}"
                                        id="TextLabelCodBarras2ID"
                                    />
                                    <Input
                                        xmlns:core="sap.ui.core"
                                        xmlns:sap.ui.layout.form="sap.ui.layout.form"
                                        xmlns="sap.m"
                                         placeholder="{i18n>barPlaceHolder}"
                                        width="100%"
                                        id="InputCodBarras2ID"
                                    />
                                </items>
                            </VBox>
                        </sap.ui.layout.form:content>
                    </sap.ui.layout.form:SimpleForm>
                </items>
            </VBox>
        </content>

        <endButton>
            <Button
                xmlns="sap.m"
                text="{i18n>barBtnContinuar}"
                id="buttonContinuarCodBarrasID"
                type="Emphasized"
                press=".onSliceCheck"
            />
        </endButton>

        <beginButton>
            <Button
                xmlns="sap.m"
                text="{i18n>barBtnCancelar}"
                id="BtnCancelarCodBarras2"
                type="Reject"
                press="onCloseBarCode"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
