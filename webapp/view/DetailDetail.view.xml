<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:mdc="sap.ui.mdc"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true"
    controllerName="br.com.klabin.zewmpicking2.controller.Details"
    height="100%"
>
    <Page
        xmlns="sap.m"
        id="pageId"
        title="{i18n>pickings}"
        titleAlignment="Center"
    >
